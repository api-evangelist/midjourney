  "info": {
    "_postman_id": "1e13894b-7f69-4433-a354-4bfe280b205e",
    "name": "Midjourney Image Generation Image Analysis Jobs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Midjourney Image Generation API provides programmatic access to Midjourney's AI-powered image generation capabilities. Developers can submit text prompts to generate images, upscale selected outputs to higher resolutions, create variations of generated images, describe existing images to generate prompts, and blend multiple images together. The API uses an asynchronous job-based workflow where image generation requests return a job identifier that can be polled for status and results. Webhook callbacks are supported for real-time job status notifications. Enterprise API access is available through the Midjourney Enterprise dashboard.\n\nContact Support:\n Name: Midjourney Support",
      "type": "text/plain"
    }
  }
}