          "name": "List image generation jobs",
          "request": {
            "name": "List image generation jobs",
            "description": {
              "content": "Retrieves a paginated list of image generation jobs for the authenticated account. Jobs can be filtered by status and sorted by creation date. Returns job metadata including status, prompts, and result URLs for completed jobs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter jobs by their current status."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of jobs to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of jobs to skip for pagination."
                },
