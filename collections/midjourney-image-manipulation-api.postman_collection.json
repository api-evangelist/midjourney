        {
          "id": "4bc30c49-89c5-4d04-ba66-42e806035eca",
          "name": "Upscale a generated image to higher resolution",
          "request": {
            "name": "Upscale a generated image to higher resolution",
            "description": {
              "content": "Upscales a specific image from a previously generated image grid to a higher resolution. Requires the job identifier of the original generation and the index of the image to upscale (1-4). The upscaled image is produced asynchronously and the result can be retrieved via the job status endpoint or webhook callback.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "upscale"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
