      "name": "Jobs",
      "description": {
        "content": "Operations for tracking and managing asynchronous image generation jobs, including retrieving job status, results, and listing previous jobs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f273f4a0-1d66-4300-84e6-f10d0d23ade9",
          "name": "Get the status and results of a job",
          "request": {
            "name": "Get the status and results of a job",
            "description": {
              "content": "Retrieves the current status, progress, and results of an asynchronous image generation job. Returns the job metadata including status, progress percentage, and when complete, the URLs of the generated images. Poll this endpoint to track job progress when webhooks are not configured.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "jobs",
                ":jobId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "jobId",
                  "description": "(Required) The unique identifier of the image generation job."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
